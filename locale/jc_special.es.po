msgstr "Sintaxis no válida. Uso: /jail <jugador> <razón>"

#: prison.lua
msgid "Invalid syntax! Usage: /unjail <player> <reason>"
msgstr "Sintaxis no válida. Uso: /unjail <jugador> <razón>"

#: prison.lua
msgid "Player @1 not found."
msgstr "Jugador @1 no encontrado."

#: prison.lua
msgid "Player @1 is already jailed."
msgstr "El jugador @1 ya está encarcelado."

#: prison.lua
msgid "Player @1 has been jailed"
msgstr "El jugador @1 ha sido encarcelado"

#: prison.lua
msgid "Player @1 was never jailed"
msgstr "El jugador @1 nunca estuvo encarcelado"

#: prison.lua
msgid "Player @1 has been unjailed"
msgstr "El jugador @1 ha sido liberado de prisión"

#: prison.lua
msgid "Jails Players"
msgstr "Encárcela jugadores"

#: prison.lua
msgid "Unjails players"
msgstr "Libera jugadores de prisión"

msgid "Direct Mob Spawner"
msgstr "Generador de mobs directo"

msgid "(mob name) (min light) (max light) (amount) (player distance) (Y offset)"
msgstr "(nombre del mob) (luz mínima) (luz máxima) (cantidad) (distancia del jugador) (desplazamiento Y)"

msgid "Command:"
msgstr "Comando:"

msgid "Direct Mob Spawner Not Active (enter settings)"
msgstr "Generador de mobs directo no activo (introduce la configuración)"

msgid "Direct Mob Spawner Active (@1)"
msgstr "Generador de mobs directo activo (@1)"

msgid "Direct Mob Spawner settings failed!"
msgstr "¡La configuración del generador de mobs directo ha fallado!"

msgid "Syntax: “name min_light[0-15] max_light[0-15] max_mobs[0 to disable] player_distance[1-20] y_offset[-9 to 9]”"
msgstr "Sintaxis: «nombre min_light[0-15] max_light[0-15] max_mobs[0 para desactivar] player_distance[1-20] y_offset[-9 a 9]»"