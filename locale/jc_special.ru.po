msgstr "Тюремный каменный кирпич"

#: prison.lua
msgid "Invalid syntax! Usage: /jail <player> <reason>"
msgstr "Неверный синтаксис! Использование: /jail <игрок> <причина>"

#: prison.lua
msgid "Invalid syntax! Usage: /unjail <player> <reason>"
msgstr "Неверный синтаксис! Использование: /unjail <игрок> <причина>"

#: prison.lua
msgid "Player @1 not found."
msgstr "Игрок @1 не найден."

#: prison.lua
msgid "Player @1 is already jailed."
msgstr "Игрок @1 уже находится в тюрьме."

#: prison.lua
msgid "Player @1 has been jailed"
msgstr "Игрок @1 был заключён в тюрьму"

#: prison.lua
msgid "Player @1 was never jailed"
msgstr "Игрок @1 никогда не был заключён в тюрьму"

#: prison.lua
msgid "Player @1 has been unjailed"
msgstr "Игрок @1 был освобождён из тюрьмы"

#: prison.lua
msgid "Jails Players"
msgstr "Заключает игроков в тюрьму"

#: prison.lua
msgid "Unjails players"
msgstr "Освобождает игроков из тюрьмы"

msgid "Direct Mob Spawner"
msgstr "Прямой спавнер мобов"

msgid "(mob name) (min light) (max light) (amount) (player distance) (Y offset)"
msgstr "(имя моба) (мин. освещение) (макс. освещение) (количество) (дистанция до игрока) (смещение Y)"

msgid "Command:"
msgstr "Команда:"

msgid "Direct Mob Spawner Not Active (enter settings)"
msgstr "Прямой спавнер мобов неактивен (введите настройки)"

msgid "Direct Mob Spawner Active (@1)"
msgstr "Прямой спавнер мобов активен (@1)"

msgid "Direct Mob Spawner settings failed!"
msgstr "Не удалось сохранить настройки прямого спавнера мобов!"

msgid "Syntax: “name min_light[0-15] max_light[0-15] max_mobs[0 to disable] player_distance[1-20] y_offset[-9 to 9]”"
msgstr "Синтаксис: «имя min_light[0-15] max_light[0-15] max_mobs[0 для отключения] player_distance[1-20] y_offset[-9 до 9]»"