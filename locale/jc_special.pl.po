msgid "Water Can"
msgstr "Konewka na wodę"

msgid "Jumbo Water Can"
msgstr "Duża konewka na wodę"

msgid "Freshwater Can"
msgstr "Konewka na świeżą wodę"

msgid "Lava Can"
msgstr "Konewka na lawę"

msgid "Please wait until your can has been filled."
msgstr "Poczekaj, aż Twoja konewka zostanie napełniona."

msgid "You don't have room for the filled can."
msgstr "Nie masz miejsca na napełnioną konewkę."

msgid "This tree trunk well is owned by %s. You can't use it."
msgstr "Ta studnia w pniu drzewa należy do %s. Nie możesz jej używać."

msgid "The well is already being used."
msgstr "Studnia jest już używana."

msgid "Your Freshwater Can is already full."
msgstr "Twoja konewka na świeżą wodę jest już pełna."

msgid "Your Freshwater Can is now full!"
msgstr "Twoja konewka na świeżą wodę jest teraz pełna!"

msgid "Day Button"
msgstr "Przycisk dnia"

msgid "Press to skip the night."
msgstr "Naciśnij, aby pominąć noc."

msgid "@1 skipped the night."
msgstr "@1 pominął noc."

msgid "MrPhil's Wooden Bag"
msgstr "Drewniana torba MrPhila"

msgid "Enable or disable join greeter"
msgstr "Włącz lub wyłącz powitanie przy dołączeniu"

msgid "Not allowed."
msgstr "Niedozwolone."

msgid "Join greeter enabled"
msgstr "Powitanie przy dołączeniu włączone"

msgid "Join greeter disabled"
msgstr "Powitanie przy dołączeniu wyłączone"

msgid "Use: /greet on | off"
msgstr "Użycie: /greet on | off"

msgid "Show loaded mods"
msgstr "Pokaż załadowane mody"

msgid "Loaded Mods"
msgstr "Załadowane mody"

msgid "Close"
msgstr "Zamknij"

msgid "@1 is at @2"
msgstr "@1 jest w @2"

msgid "Shows the coordinates of a player."
msgstr "Pokazuje współrzędne gracza."

msgid "Usage: /where <player>"
msgstr "Użycie: /where <gracz>"

msgid "Player @1 is not online."
msgstr "Gracz @1 nie jest online."

msgid "The /shutdown command has been disabled on this server."
msgstr "Polecenie /shutdown zostało wyłączone na tym serwerze."

msgid "Count Animalia bats"
msgstr "Policz nietoperze Animalia"

msgid "There are @1 Animalia bats nearby."
msgstr "W pobliżu znajduje się @1 nietoperzy Animalia."

msgid "Remove all loaded Animalia bats"
msgstr "Usuń wszystkie załadowane nietoperze Animalia"

msgid "Player not found."
msgstr "Nie znaleziono gracza."

msgid "Removed @1 Animalia bats."
msgstr "Usunięto @1 nietoperzy Animalia."

msgid "Play a welcome sound for all connected players."
msgstr "Odtwórz dźwięk powitalny dla wszystkich połączonych graczy."

msgid "Available sounds: welcome, glockenspiel, welcome_stranger\nUsage: /welcome_sound <sound>"
msgstr "Dostępne dźwięki: welcome, glockenspiel, welcome_stranger\nUżycie: /welcome_sound <dźwięk>"

msgid "No sounds found with that name.\nAvailable: welcome, glockenspiel, welcome_stranger"
msgstr "Nie znaleziono dźwięków o tej nazwie.\nDostępne: welcome, glockenspiel, welcome_stranger"

msgid "Playing '@1' for all connected players."
msgstr "Odtwarzanie „@1” dla wszystkich połączonych graczy."

msgid "Welcome to the Just-Craft server, @1!"
msgstr "Witamy na serwerze Just-Craft, @1!"

msgid "Type: @1 to get your free apartment!"
msgstr "Wpisz: @1, aby otrzymać swoje darmowe mieszkanie!"

msgid "*** NEW PLAYER: @1 has joined the server for the first time. Information about apartments already sent to new player."
msgstr "*** NOWY GRACZ: @1 dołączył do serwera po raz pierwszy. Informacje o mieszkaniach zostały już wysłane do nowego gracza."

msgid "Mailbox for: @1"
msgstr "Skrzynka pocztowa: @1"

msgid "Get Items"
msgstr "Odbierz przedmioty"

msgid "Mailbox Owner: @1"
msgstr "Właściciel skrzynki: @1"

msgid "Mailbox\nUnowned"
msgstr "Skrzynka pocztowa\nBez właściciela"

msgid "has deposited mail for you at"
msgstr "zostawił dla Ciebie pocztę w"

msgid "[Mailbox] @1 has deposited mail for you at @2."
msgstr "[Skrzynka pocztowa] @1 zostawił dla Ciebie pocztę w @2."

msgid "Grandfather Clock\n@1"
msgstr "Zegar stojący\n@1"

msgid "Open a text box to paste a message into chat."
msgstr "Otwórz pole tekstowe, aby wkleić wiadomość na czat."

msgid "Paste Message"
msgstr "Wklej wiadomość"

msgid "Enter your chat message here (maximum 500 characters):"
msgstr "Wpisz lub wklej tutaj wiadomość na czat (maksymalnie 500 znaków):"

msgid "SEND"
msgstr "WYŚLIJ"

msgid "CANCEL"
msgstr "ANULUJ"

msgid "Your message is limited to 500 characters."
msgstr "Twoja wiadomość jest ograniczona do 500 znaków."

msgid "The message cannot be empty."
msgstr "Wiadomość nie może być pusta."

msgid "Trooper"
msgstr "Trooper"

msgid "Castle Guard"
msgstr "Strażnik Zamku"

msgid "@1 was eliminated by @2!"
msgstr "@1 został wyeliminowany przez @2!"

msgid "Find nodes within a square radius"
msgstr "Znajdź bloki w kwadratowym promieniu"

msgid "Player not found."
msgstr "Nie znaleziono gracza."

msgid "Usage: /findnode <mod:nodename> <radius>"
msgstr "Użycie: /findnode <mod:nodename> <promień>"

msgid "Radius must be a number."
msgstr "Promień musi być liczbą."

msgid "Radius must be greater than 0."
msgstr "Promień musi być większy od 0."

msgid "Could not determine your position."
msgstr "Nie można określić twojej pozycji."

msgid "Unknown node: @1"
msgstr "Nieznany blok: @1"

msgid "No @1 found within @2 nodes."
msgstr "Nie znaleziono @1 w promieniu @2 bloków."

msgid "Found @1 @2 within a @3 node square:"
msgstr "Znaleziono @1 @2 w kwadracie o boku @3 bloków:"

msgid "@1 - @2 nodes away"
msgstr "@1 - @2 bloków stąd"

