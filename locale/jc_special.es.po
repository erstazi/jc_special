msgid "Water Can"
msgstr "Bidón de Agua"

msgid "Jumbo Water Can"
msgstr "Bidón de Agua Grande"

msgid "Freshwater Can"
msgstr "Bidón de Agua Dulce"

msgid "Lava Can"
msgstr "Lata de Lava"

msgid "Please wait until your can has been filled."
msgstr "Espera hasta que tu regadera se haya llenado."

msgid "You don't have room for the filled can."
msgstr "No tienes espacio para la regadera llena."

msgid "This tree trunk well is owned by %s. You can't use it."
msgstr "Este pozo de tronco pertenece a %s. No puedes usarlo."

msgid "The well is already being used."
msgstr "El pozo ya está en uso."

msgid "Your Freshwater Can is already full."
msgstr "Tu regadera de agua dulce ya está llena."

msgid "Your Freshwater Can is now full!"
msgstr "¡Tu regadera de agua dulce ya está llena!"

msgid "Day Button"
msgstr "Botón de día"

msgid "Press to skip the night."
msgstr "Pulsa para saltarte la noche."

msgid "@1 skipped the night."
msgstr "@1 se saltó la noche."

msgid "MrPhil's Wooden Bag"
msgstr "Bolsa de madera de MrPhil"

msgid "Enable or disable join greeter"
msgstr "Activar o desactivar el saludo al entrar"

msgid "Not allowed."
msgstr "No permitido."

msgid "Join greeter enabled"
msgstr "Saludo al entrar activado"

msgid "Join greeter disabled"
msgstr "Saludo al entrar desactivado"

msgid "Use: /greet on | off"
msgstr "Uso: /greet on | off"

msgid "Show loaded mods"
msgstr "Mostrar mods cargados"

msgid "Loaded Mods"
msgstr "Mods cargados"

msgid "Close"
msgstr "Cerrar"

msgid "@1 is at @2"
msgstr "@1 está en @2"

msgid "Shows the coordinates of a player."
msgstr "Muestra las coordenadas de un jugador."

msgid "Usage: /where <player>"
msgstr "Uso: /where <player>"

msgid "Player @1 is not online."
msgstr "El jugador @1 no está conectado."

msgid "The /shutdown command has been disabled on this server."
msgstr "El comando /shutdown ha sido desactivado en este servidor."

msgid "Count Animalia bats"
msgstr "Contar murciélagos de Animalia"

msgid "There are @1 Animalia bats nearby."
msgstr "Hay @1 murciélagos de Animalia cerca."

msgid "Remove all loaded Animalia bats"
msgstr "Eliminar todos los murciélagos de Animalia cargados"

msgid "Player not found."
msgstr "Jugador no encontrado."

msgid "Removed @1 Animalia bats."
msgstr "Se eliminaron @1 murciélagos de Animalia."

msgid "Play a welcome sound for all connected players."
msgstr "Reproducir un sonido de bienvenida para todos los jugadores conectados."

msgid "Available sounds: welcome, glockenspiel, welcome_stranger\nUsage: /welcome_sound <sound>"
msgstr "Sonidos disponibles: welcome, glockenspiel, welcome_stranger\nUso: /welcome_sound <sound>"

msgid "No sounds found with that name.\nAvailable: welcome, glockenspiel, welcome_stranger"
msgstr "No se encontraron sonidos con ese nombre.\nDisponibles: welcome, glockenspiel, welcome_stranger"

msgid "Playing '@1' for all connected players."
msgstr "Reproduciendo «@1» para todos los jugadores conectados."

msgid "Welcome to the Just-Craft server, @1!"
msgstr "¡Bienvenido al servidor Just-Craft, @1!"

msgid "Type: @1 to get your free apartment!"
msgstr "Escribe @1 para obtener tu apartamento gratis."

msgid "*** NEW PLAYER: @1 has joined the server for the first time. Information about apartments already sent to new player."
msgstr "*** NUEVO JUGADOR: @1 se ha unido al servidor por primera vez. Ya se ha enviado información sobre los apartamentos al nuevo jugador."

msgid "Mailbox for: @1"
msgstr "Buzón para: @1"

msgid "Get Items"
msgstr "Recoger objetos"

msgid "Mailbox Owner: @1"
msgstr "Propietario del buzón: @1"

msgid "Mailbox\nUnowned"
msgstr "Buzón\nSin propietario"

msgid "has deposited mail for you at"
msgstr "ha dejado correo para ti en"

msgid "[Mailbox] @1 has deposited mail for you at @2."
msgstr "[Buzón] @1 ha dejado correo para usted en @2."

msgid "Grandfather Clock\n@1"
msgstr "Reloj de pie\n@1"

msgid "Open a text box to paste a message into chat."
msgstr "Abre un cuadro de texto para pegar un mensaje en el chat."

msgid "Paste Message"
msgstr "Pegar mensaje"

msgid "Enter your chat message here (maximum 500 characters):"
msgstr "Escribe o pega aquí tu mensaje de chat (máximo 500 caracteres):"

msgid "SEND"
msgstr "ENVIAR"

msgid "CANCEL"
msgstr "CANCELAR"

msgid "Your message is limited to 500 characters."
msgstr "Tu mensaje está limitado a 500 caracteres."

msgid "The message cannot be empty."
msgstr "El mensaje no puede estar vacío."