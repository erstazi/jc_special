msgid "Water Can"
msgstr "Arrosoir"

msgid "Jumbo Water Can"
msgstr "Grand arrosoir"

msgid "Freshwater Can"
msgstr "Arrosoir d'eau douce"

msgid "Lava Can"
msgstr "Arrosoir de lave"

msgid "Please wait until your can has been filled."
msgstr "Veuillez patienter jusqu'à ce que votre arrosoir soit rempli."

msgid "You don't have room for the filled can."
msgstr "Vous n'avez pas de place pour l'arrosoir rempli."

msgid "This tree trunk well is owned by %s. You can't use it."
msgstr "Ce puits en tronc d'arbre appartient à %s. Vous ne pouvez pas l'utiliser."

msgid "The well is already being used."
msgstr "Le puits est déjà utilisé."

msgid "Your Freshwater Can is already full."
msgstr "Votre arrosoir d'eau douce est déjà plein."

msgid "Your Freshwater Can is now full!"
msgstr "Votre arrosoir d'eau douce est maintenant plein !"

msgid "Day Button"
msgstr "Bouton de jour"

msgid "Press to skip the night."
msgstr "Appuyez pour passer la nuit."

msgid "@1 skipped the night."
msgstr "@1 a passé la nuit."

msgid "MrPhil's Wooden Bag"
msgstr "Sac en bois de MrPhil"

msgid "Enable or disable join greeter"
msgstr "Activer ou désactiver le message d'accueil à la connexion"

msgid "Not allowed."
msgstr "Non autorisé."

msgid "Join greeter enabled"
msgstr "Message d'accueil à la connexion activé"

msgid "Join greeter disabled"
msgstr "Message d'accueil à la connexion désactivé"

msgid "Use: /greet on | off"
msgstr "Utilisation : /greet on | off"

msgid "Show loaded mods"
msgstr "Afficher les mods chargés"

msgid "Loaded Mods"
msgstr "Mods chargés"

msgid "Close"
msgstr "Fermer"

msgid "@1 is at @2"
msgstr "@1 se trouve à @2"

msgid "Shows the coordinates of a player."
msgstr "Affiche les coordonnées d'un joueur."

msgid "Usage: /where <player>"
msgstr "Utilisation: /where <player>"

msgid "Player @1 is not online."
msgstr "Le joueur @1 n'est pas en ligne."

msgid "The /shutdown command has been disabled on this server."
msgstr "La commande /shutdown a été désactivée sur ce serveur."

msgid "Count Animalia bats"
msgstr "Compter les chauves-souris d'Animalia"

msgid "There are @1 Animalia bats nearby."
msgstr "Il y a @1 chauves-souris d'Animalia à proximité."

msgid "Remove all loaded Animalia bats"
msgstr "Supprimer toutes les chauves-souris d'Animalia chargées"

msgid "Player not found."
msgstr "Joueur introuvable."

msgid "Removed @1 Animalia bats."
msgstr "@1 chauves-souris d'Animalia supprimées."

msgid "Play a welcome sound for all connected players."
msgstr "Jouer un son d'accueil pour tous les joueurs connectés."

msgid "Available sounds: welcome, glockenspiel, welcome_stranger\nUsage: /welcome_sound <sound>"
msgstr "Sons disponibles : welcome, glockenspiel, welcome_stranger\nUtilisation : /welcome_sound <sound>"

msgid "No sounds found with that name.\nAvailable: welcome, glockenspiel, welcome_stranger"
msgstr "Aucun son trouvé avec ce nom.\nDisponibles : welcome, glockenspiel, welcome_stranger"

msgid "Playing '@1' for all connected players."
msgstr "Lecture de « @1 » pour tous les joueurs connectés."

msgid "Welcome to the Just-Craft server, @1!"
msgstr "Bienvenue sur le serveur Just-Craft, @1 !"

msgid "Type: @1 to get your free apartment!"
msgstr "Tapez @1 pour obtenir votre appartement gratuit !"

msgid "*** NEW PLAYER: @1 has joined the server for the first time. Information about apartments already sent to new player."
msgstr "*** NOUVEAU JOUEUR : @1 a rejoint le serveur pour la première fois. Les informations sur les appartements ont déjà été envoyées au nouveau joueur."

msgid "Mailbox for: @1"
msgstr "Boîte aux lettres de : @1"

msgid "Get Items"
msgstr "Récupérer les objets"

msgid "Mailbox Owner: @1"
msgstr "Propriétaire de la boîte aux lettres : @1"

msgid "Mailbox\nUnowned"
msgstr "Boîte aux lettres\nSans propriétaire"

msgid "has deposited mail for you at"
msgstr "a déposé du courrier pour vous à"

msgid "[Mailbox] @1 has deposited mail for you at @2."
msgstr "[Boîte aux lettres] @1 vous a déposé du courrier à @2."

msgid "Grandfather Clock\n@1"
msgstr "Horloge de parquet\n@1"

msgid "Open a text box to paste a message into chat."
msgstr "Ouvre une zone de texte pour coller un message dans le chat."

msgid "Paste Message"
msgstr "Coller le message"

msgid "Enter your chat message here (maximum 500 characters):"
msgstr "Saisissez ou collez votre message ici (500 caractères maximum) :"

msgid "SEND"
msgstr "ENVOYER"

msgid "CANCEL"
msgstr "ANNULER"

msgid "Your message is limited to 500 characters."
msgstr "Votre message est limité à 500 caractères."

msgid "The message cannot be empty."
msgstr "Le message ne peut pas être vide."

msgid "Trooper"
msgstr "Soldat"

msgid "Castle Guard"
msgstr "Garde du Château"

msgid "@1 was eliminated by @2!"
msgstr "@1 a été éliminé par @2 !"

msgid "Find nodes within a square radius"
msgstr "Trouver des blocs dans un rayon carré"

msgid "Player not found."
msgstr "Joueur introuvable."

msgid "Usage: /findnode <mod:nodename> <radius>"
msgstr "Utilisation : /findnode <mod:nodename> <rayon>"

msgid "Radius must be a number."
msgstr "Le rayon doit être un nombre."

msgid "Radius must be greater than 0."
msgstr "Le rayon doit être supérieur à 0."

msgid "Could not determine your position."
msgstr "Impossible de déterminer votre position."

msgid "Unknown node: @1"
msgstr "Bloc inconnu : @1"

msgid "No @1 found within @2 nodes."
msgstr "Aucun @1 trouvé dans un rayon de @2 blocs."

msgid "Found @1 @2 within a @3 node square:"
msgstr "@1 @2 trouvé(s) dans un carré de @3 blocs :"

msgid "@1 - @2 nodes away"
msgstr "@1 - à @2 blocs"

